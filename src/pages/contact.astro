---
import Layout from "../layouts/Page.astro";
---

<Layout
  title="Contact"
  description="Lorem ipsum dolor sit amet"
  pubDate={new Date("August 08 2021")}
>
  <form method="POST" id="form" class="max-w-md mx-auto space-y-4">
    <input
      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
      type="hidden"
      name="access_key"
      value="cc6df478-e705-4d70-9604-9a1f8975c475"
    />

    <input
      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
      type="text"
      name="name"
      placeholder="Your name"
      required
    />
    <input
      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
      type="email"
      name="email"
      placeholder="Your email"
      required
    />
    <textarea
      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent resize-vertical"
      name="message"
      placeholder="Your message"
      rows="5"
      required></textarea>
    <button
      class="w-full px-4 py-2 bg-primary text-white rounded-md hover:bg-primary/90 transition-fast focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
      type="submit">Submit Form</button
    >
    <div id="result" class="text-center"></div>
  </form>

  <script is:inline>
    const form = document.getElementById("form");
    const result = document.getElementById("result");

    form.addEventListener("submit", function (e) {
      const formData = new FormData(form);
      e.preventDefault();

      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      result.innerHTML = "Please wait...";

      fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: json,
      })
        .then(async (response) => {
          let json = await response.json();
          if (response.status == 200) {
            result.innerHTML = json.message;
          } else {
            console.log(response);
            result.innerHTML = json.message;
          }
        })
        .catch((error) => {
          console.log(error);
          result.innerHTML = "Something went wrong!";
        })
        .then(function () {
          form.reset();
          setTimeout(() => {
            result.style.display = "none";
          }, 3000);
        });
    });
  </script>
</Layout>
