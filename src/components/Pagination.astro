---
const { currentPage, totalPages } = Astro.props;

const createPaginationArray = (total: number) =>
  Array.from({ length: total }, (_, i) => i + 1);

const pages = createPaginationArray(totalPages);
---

<nav aria-label="Pagination" id="pagination-nav" class="flex justify-center gap-2 mt-8">
  {
    pages.map((page) => (
      <a
        href={`/?page=${page}`}
        class:list={[
          "pagination-btn",
          page === currentPage ? "pagination-btn-active" : ""
        ]}
        data-page={page}
        hx-boost="true"
        hx-target="#post-contents"
        hx-select="#post-contents"
        hx-swap="innerHTML"
        hx-trigger="click"
      >
        {page}
      </a>
    ))
  }
</nav>

<style>
  .pagination-btn {
    @apply mx-1 px-3 py-2 bg-gray-200 rounded-md cursor-pointer transition-fast;
  }
  
  .pagination-btn:hover {
    @apply bg-gray-300;
  }
  
  .pagination-btn-active {
    @apply bg-primary text-white;
  }
  
  .pagination-btn-active:hover {
    @apply bg-primary;
  }
</style>

<script>
  document.addEventListener('htmx:afterSwap', function(event) {
    const customEvent = event as CustomEvent;
    if (customEvent.detail.target.id === 'post-contents') {
      const currentPage = new URLSearchParams(window.location.search).get('page') || '1';
      const paginationLinks = document.querySelectorAll('#pagination-nav a');
      paginationLinks.forEach(link => {
        if (link.getAttribute('data-page') === currentPage) {
          link.classList.add('pagination-btn-active');
        } else {
          link.classList.remove('pagination-btn-active');
        }
      });
    }
  });
</script>
